{"rank": 2406, "kind": "function", "entry": "decode_header", "starter": "from typing import Any, Dict\n\n\ndef decode_header(hex_str: str) -> Dict[str, Any]:\n    pass\n", "compare": "exact", "notes": "Return {\"version\", \"type\", \"flags\", \"length\", \"sequence\"}, with flags listing the set ones in the order ACK, SYN, URGENT ([] if none; bits 2-6 are ignored). The input must be exactly 16 hex digits (either case, no spaces or 0x): any other length returns {\"error\": \"bad length\"}, and 16 characters that aren't all hex digits return {\"error\": \"bad hex\"}.", "tests": [{"args": ["2183001400000007"], "hidden": false, "expected": {"version": 2, "type": 1, "flags": ["ACK", "SYN", "URGENT"], "length": 20, "sequence": 7}}, {"args": ["1a0205dc0000ffff"], "hidden": false, "expected": {"version": 1, "type": 10, "flags": ["SYN"], "length": 1500, "sequence": 65535}}, {"args": ["2183"], "hidden": false, "expected": {"error": "bad length"}}, {"args": ["0000000000000000"], "hidden": true, "expected": {"version": 0, "type": 0, "flags": [], "length": 0, "sequence": 0}}, {"args": ["FFFFFFFFFFFFFFFF"], "hidden": true, "expected": {"version": 15, "type": 15, "flags": ["ACK", "SYN", "URGENT"], "length": 65535, "sequence": 4294967295}}, {"args": ["ff7cffff00010000"], "hidden": true, "expected": {"version": 15, "type": 15, "flags": [], "length": 65535, "sequence": 65536}}, {"args": ["4C800040DEADBEEF"], "hidden": true, "expected": {"version": 4, "type": 12, "flags": ["URGENT"], "length": 64, "sequence": 3735928559}}, {"args": ["31010000 0000001"], "hidden": true, "expected": {"error": "bad hex"}}, {"args": ["21830014000000zz"], "hidden": true, "expected": {"error": "bad hex"}}, {"args": [""], "hidden": true, "expected": {"error": "bad length"}}, {"args": ["218300140000000"], "hidden": true, "expected": {"error": "bad length"}}, {"args": ["218300140000000700"], "hidden": true, "expected": {"error": "bad length"}}, {"args": ["0x83001400000007"], "hidden": true, "expected": {"error": "bad hex"}}, {"args": ["f0028000aBcDeF01"], "hidden": true, "expected": {"version": 15, "type": 0, "flags": ["SYN"], "length": 32768, "sequence": 2882400001}}, {"args": ["dCa9BDd2fdEf6BdD"], "hidden": true, "expected": {"version": 13, "type": 12, "flags": ["ACK", "URGENT"], "length": 48594, "sequence": 4260326365}}, {"args": ["e0d4D5f53A928a62"], "hidden": true, "expected": {"version": 14, "type": 0, "flags": ["URGENT"], "length": 54773, "sequence": 982682210}}, {"args": ["EAc1f3A4efbCE9B1"], "hidden": true, "expected": {"version": 14, "type": 10, "flags": ["ACK", "URGENT"], "length": 62372, "sequence": 4022135217}}, {"args": ["aaBc30Bdcbf7d5E3"], "hidden": true, "expected": {"version": 10, "type": 10, "flags": ["URGENT"], "length": 12477, "sequence": 3422016995}}, {"args": ["C8D6aD45e7D3BE94"], "hidden": true, "expected": {"version": 12, "type": 8, "flags": ["SYN", "URGENT"], "length": 44357, "sequence": 3889413780}}, {"args": ["6E7fE7eE6FD5CF4f"], "hidden": true, "expected": {"version": 6, "type": 14, "flags": ["ACK", "SYN"], "length": 59374, "sequence": 1876283215}}]}
