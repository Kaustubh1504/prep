{"rank": 2409, "kind": "function", "entry": "run_steps", "starter": "import copy\nfrom typing import Any, Dict, List\n\n\n# Both functions below are buggy. Fix them (keep their names and parameters).\n\ndef add_tag(tag, tags=[]):\n    \"\"\"Append tag to tags and return the list (a new list when tags isn't given).\"\"\"\n    tags.append(tag)\n    return tags\n\n\ndef clone_config(cfg, target):\n    \"\"\"Return a copy of cfg with target appended to its \"targets\" list; cfg itself must not change.\"\"\"\n    new = cfg.copy()\n    new[\"targets\"].append(target)\n    return new\n\n\n# ---------------------------------------------------------------------------\n# Provided \u2014 keep this. The tests call run_steps with a list of steps:\n#   [\"add_tag\", tag]              -> add_tag(tag)\n#   [\"add_tag\", tag, tags]        -> add_tag(tag, my_list), where my_list starts as a copy of tags\n#   [\"clone_config\", cfg, target] -> clone_config(cfg, target)\n# and report what each call returned and what happened to the caller's objects.\n# ---------------------------------------------------------------------------\ndef _containers(value, found):\n    if isinstance(value, (dict, list, set)):\n        found.add(id(value))\n        for child in (value.values() if isinstance(value, dict) else value):\n            _containers(child, found)\n    return found\n\n\ndef run_steps(steps: List[list]) -> List[Dict[str, Any]]:\n    report = []\n    for step in steps:\n        if step[0] == \"add_tag\" and len(step) == 2:\n            report.append({\"returned\": copy.deepcopy(add_tag(step[1]))})\n        elif step[0] == \"add_tag\":\n            mine = list(step[2])\n            returned = add_tag(step[1], mine)\n            report.append({\"returned\": copy.deepcopy(returned), \"caller_list\": list(mine)})\n        else:\n            cfg = copy.deepcopy(step[1])\n            clone = clone_config(cfg, step[2])\n            shared = bool(_containers(cfg, set()) & _containers(clone, set()))\n            report.append({\"clone\": copy.deepcopy(clone), \"original\": copy.deepcopy(cfg), \"shares_nested\": shared})\n    return report\n", "compare": "exact", "notes": "add_tag(tag) must start from a fresh list on every call, and add_tag(tag, tags) must append to the caller's own list and return it (even when it's empty). clone_config must deep-copy: the clone may share no nested list or dict with cfg, and cfg must stay unchanged. run_steps is provided: it calls your functions and reports what each returned and what happened to the caller's objects.", "tests": [{"args": [[["add_tag", "a"], ["add_tag", "b"]]], "expected": [{"returned": ["a"]}, {"returned": ["b"]}], "hidden": false}, {"args": [[["clone_config", {"name": "fw-ci", "targets": ["iphone"]}, "ipad"]]], "expected": [{"clone": {"name": "fw-ci", "targets": ["iphone", "ipad"]}, "original": {"name": "fw-ci", "targets": ["iphone"]}, "shares_nested": false}], "hidden": false}, {"args": [[["add_tag", "x", ["build"]], ["add_tag", "y"]]], "expected": [{"returned": ["build", "x"], "caller_list": ["build", "x"]}, {"returned": ["y"]}], "hidden": false}, {"args": [[["add_tag", "a"], ["add_tag", "b"], ["add_tag", "c"]]], "expected": [{"returned": ["a"]}, {"returned": ["b"]}, {"returned": ["c"]}], "hidden": true}, {"args": [[["add_tag", "nightly", []], ["add_tag", "smoke"]]], "expected": [{"returned": ["nightly"], "caller_list": ["nightly"]}, {"returned": ["smoke"]}], "hidden": true}, {"args": [[["add_tag", "a"], ["add_tag", "b", ["x", "y"]], ["add_tag", "c"], ["add_tag", "d", []]]], "expected": [{"returned": ["a"]}, {"returned": ["x", "y", "b"], "caller_list": ["x", "y", "b"]}, {"returned": ["c"]}, {"returned": ["d"], "caller_list": ["d"]}], "hidden": true}, {"args": [[["clone_config", {"name": "fw", "targets": []}, "watch"]]], "expected": [{"clone": {"name": "fw", "targets": ["watch"]}, "original": {"name": "fw", "targets": []}, "shares_nested": false}], "hidden": true}, {"args": [[["clone_config", {"name": "f